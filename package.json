{
  "name": "specops-workbench",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @specops/db migrate"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.12"
    }
  },
  "packageManager": "pnpm@9.12.3"
}
